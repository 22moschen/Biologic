# Neon: connection with -pooler hostname, TLS required. Never commit real values.
# Example: postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/biologic?sslmode=require
DATABASE_URL=""
# Direct Neon connection for Prisma 6 migrations.
# Example: postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/biologic?sslmode=require
DIRECT_URL=""
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
PATIENT_ACCESS_DAYS="7"
# Optional real public contact. Leave blank when unavailable.
PUBLIC_CONTACT_EMAIL=""
PUBLIC_CONTACT_PHONE=""
# Explicit, opt-in demo seed, for a NEW dedicated database only.
ALLOW_DEMO_SEED="false"
DEMO_ADMIN_EMAIL="admin@biologic.example"
DEMO_ADMIN_PASSWORD=""
DEMO_ATTENDANT_EMAIL="atendente@biologic.example"
DEMO_ATTENDANT_PASSWORD=""

# Alternative to demo seed: first access without demo data (empty database).
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
LABORATORY_NAME=""

# Opt-in E2E writes fictitious patients to a dedicated test database.
E2E_DATABASE_TESTS="false"
# Optional Chromium installed by the environment, otherwise: npx playwright install chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""
